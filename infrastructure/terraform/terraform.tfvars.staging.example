# ── Staging preset (free-tier) — apply with: terraform apply -var-file=terraform.tfvars.staging
aws_region   = "ap-south-1"
environment  = "staging"
project_name = "hyperlocal"

instance_type        = "t3.micro"
root_volume_gb       = 20
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20

# Phase 12 — Staging domains + HTTPS (use the staging-* subdomain set)
# The API host MUST equal the Flutter apps' staging default
# (EnvConfig.defaultBaseUrlFor(AppEnv.staging)) and the CI variable
# STAGING_API_URL, otherwise the staging APKs cannot reach staging.
domain_name          = "staging-api.hyperlocal.in"
caddy_acme_email     = "admin@hyperlocal.in"
frontend_domain      = "staging-app.hyperlocal.in"
admin_frontend_domain = "staging-admin.hyperlocal.in"
dns_zone_name        = "hyperlocal.in."
manage_dns           = true

github_branch              = "develop"
create_s3_gateway_endpoint = true
enable_vpc_flow_logs       = true
flow_log_retention_days    = 7
