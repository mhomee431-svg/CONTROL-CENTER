# ── FREE-TIER preset — copy to terraform.tfvars and apply ────────────────────
# Monthly cost: $0 inside the 12-month free tier (EC2 t3.micro 750h, EBS 30GB,
# RDS db.t3.micro 750h + 20GB, EIP while attached, S3 5GB, SSM, flow logs 14d).

aws_region   = "ap-south-1"
environment  = "production"
project_name = "hyperlocal"

# Environment separation: change `environment` per IaC run (development |
# staging | production) — name prefixes, SSM paths and state keys differ.
# Example: terraform apply -var-file=terraform.tfvars.staging

# App instance (Caddy reverse proxy + Redis container)
instance_type   = "t3.micro"
root_volume_gb  = 20
admin_cidr      = "" # no SSH port anywhere; Session Manager only

# RDS — free-tier shapes, never public
db_instance_class   = "db.t3.micro"
db_allocated_storage = 20
db_name             = "hyperlocal"
db_username         = "hyperlocal"

# Domain: set this + an A-record → the EIP output, and Caddy auto-issues
# HTTPS. Empty = plain HTTP on the EIP until you buy a domain.
domain_name = ""

# Free networking extras
github_branch        = "main"
create_s3_gateway_endpoint = true
enable_vpc_flow_logs       = true
flow_log_retention_days    = 14

# uploads_bucket_name = ""  # default: hyperlocal-<account_id>-uploads
