# Repo-wide ignores
.env
.env.*
*.log
.pytest_cache/
__pycache__/

# Private keys & certificates (NEVER commit)
*.pem
*.key
*.p12
**/*.p12
*.jks
**/*.jks
*.keystore
**/*.keystore
*.mobileprovision
**/*.mobileprovision

# Firebase service-account keys (NEVER commit)
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
serviceAccountKey*.json
**/serviceAccountKey*.json

# Terraform state & local secrets (never commit)
infra/.terraform/
infra/**/.terraform/
infra/terraform/terraform.tfvars
infra/terraform/**/terraform.tfvars
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Local build artifacts
build/
.dart_tool/
.tools/

# Keep committed env-reference examples (no real secrets)
!.env.example
!.env.production.example
!.env.free.example

# Phase 4 free-cloud state (never commit — contains provider metadata)
.free_cloud_db.json

# Phase 5 recovery-drill report (CI artifact; generated, not committed)
Backend/recovery_report.json

# Phase 25 CI/CD report (regenerated by the pipeline each run)
Backend/migration_safety_report.json

# Mobile signing material / keystores (never commit — Phase 8)
**/android/key.properties
**/ios/**/key.properties

# Phase 15 — Google Maps API key (local build-time injection)
Frontend/android/local.properties
Frontend/ios/Flutter/MapsAPIKey.xcconfig
ShopkeeperApp/android/local.properties
ShopkeeperApp/ios/Flutter/MapsAPIKey.xcconfig

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

