# Repo-wide ignores
.env
.env.*
*.log
.pytest_cache/
__pycache__/

# Private keys & certificates (NEVER commit)
*.pem
*.key
*.p12
**/*.p12
*.jks
**/*.jks
*.keystore
**/*.keystore
*.mobileprovision
**/*.mobileprovision

# GCP service account keys (NEVER commit)
config/gcp-key.json
**/gcp-key.json
*gcp*.json
**/*gcp*.json

# Firebase service-account keys (NEVER commit)
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
serviceAccountKey*.json
**/serviceAccountKey*.json

# Terraform state & local secrets (never commit)
infrastructure/.terraform/
infrastructure/**/.terraform/
infrastructure/terraform/terraform.tfvars
infrastructure/terraform/**/terraform.tfvars
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Local build artifacts
build/
.dart_tool/
.tools/

# Keep committed env-reference examples (no real secrets)
!.env.example
!.env.production.example
!.env.free.example

# Phase 4 free-cloud state (never commit — contains provider metadata)
.free_cloud_db.json

# Phase 5 recovery-drill report (CI artifact; generated, not committed)
backend/recovery_report.json

# Test-run scratch output (local verification logs)
backend/pytest_*.txt
backend/triage*.txt
backend/full_*.txt
backend/final_verify.txt
backend/hist*.txt
backend/p28.txt
backend/band.txt
hist*.txt
apps/customer_app/htest*.txt
apps/customer_app/ctest.txt
apps/customer_app/flutter_*.txt
apps/shopkeeper_app/flutter_*.txt
ftest_*.txt

# Phase 25 CI/CD report (regenerated by the pipeline each run)
backend/migration_safety_report.json

# Scratch files that once leaked credentials (untracked 2026-09-07)
backend/_ec2_env
backend/_tfstate.json
storage/_run_*.cmd
storage/*.log.err

# Redundant base64-encoded copies of scripts / configs (never commit)
*.b64

# Mobile signing material / keystores (never commit — Phase 8)
**/android/key.properties
**/ios/**/key.properties

# Phase 15 — Google Maps API key (local build-time injection)
apps/customer_app/android/local.properties
apps/customer_app/ios/Flutter/MapsAPIKey.xcconfig
apps/shopkeeper_app/android/local.properties
apps/shopkeeper_app/ios/Flutter/MapsAPIKey.xcconfig

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

