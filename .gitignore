# Repo-wide ignores
.env
.env.*
*.log
.pytest_cache/
__pycache__/

# Terraform state & local secrets (never commit)
infra/.terraform/
infra/**/.terraform/
infra/terraform/terraform.tfvars
infra/terraform/**/terraform.tfvars
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Local build artifacts
build/
.dart_tool/
.tools/

# Keep committed env-reference examples (no real secrets)
!.env.example
!.env.production.example
!.env.free.example

# Phase 4 free-cloud state (never commit — contains provider metadata)
.free_cloud_db.json

# Phase 5 recovery-drill report (CI artifact; generated, not committed)
Backend/recovery_report.json

# Firebase service-account keys (never commit)
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
serviceAccountKey*.json
**/serviceAccountKey*.json

