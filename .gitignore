# Repo-wide ignores
.env
.env.*
*.log
.pytest_cache/
__pycache__/

# Private keys & certificates (NEVER commit)
*.pem
*.key
*.p12
**/*.p12
*.jks
**/*.jks
*.keystore
**/*.keystore
*.mobileprovision
**/*.mobileprovision

# GCP service account keys (NEVER commit)
config/gcp-key.json
**/gcp-key.json
*gcp*.json
**/*gcp*.json

# Firebase service-account keys (NEVER commit)
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
serviceAccountKey*.json
**/serviceAccountKey*.json

# Terraform state & local secrets (never commit)
infrastructure/.terraform/
infrastructure/**/.terraform/
infrastructure/terraform/terraform.tfvars
infrastructure/terraform/**/terraform.tfvars
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Local build artifacts
build/
.dart_tool/
.tools/

# Keep committed env-reference examples (no real secrets)
!.env.example
!.env.production.example
!.env.free.example

# Phase 4 free-cloud state (never commit — contains provider metadata)
.free_cloud_db.json

# Phase 5 recovery-drill report (CI artifact; generated, not committed)
backend/recovery_report.json

# Test-run scratch output (local verification logs)
backend/pytest_*.txt
backend/triage*.txt
backend/full_*.txt
backend/final_verify.txt
backend/hist*.txt
backend/p28.txt
backend/band.txt
hist*.txt
apps/customer_app/htest*.txt
apps/customer_app/ctest.txt
apps/customer_app/flutter_*.txt
apps/shopkeeper_app/flutter_*.txt
ftest_*.txt

# Phase 25 CI/CD report (regenerated by the pipeline each run)
backend/migration_safety_report.json

# Scratch files that once leaked credentials (untracked 2026-09-07)
backend/_ec2_env
backend/_tfstate.json
storage/_run_*.cmd
storage/*.log.err

# Redundant base64-encoded copies of scripts / configs (never commit)
*.b64

# Mobile signing material / keystores (never commit — Phase 8)
**/android/key.properties
**/ios/**/key.properties

# Phase 15 — Google Maps API key (local build-time injection)
apps/customer_app/android/local.properties
apps/customer_app/ios/Flutter/MapsAPIKey.xcconfig
apps/shopkeeper_app/android/local.properties
apps/shopkeeper_app/ios/Flutter/MapsAPIKey.xcconfig

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db


# Stray tool output — never commit these
test_err.txt
test_out.txt
temp_file.txt

# Root-level scratch logs (analyzer / pytest / ruff output).
# These were tracked by accident: 27 files, ~1.5 MB of pure tool output that
# changed on every local run, so they polluted every diff and added noise to
# review. They are UNTRACKED (not deleted) and ignored going forward.
analyze_*.txt
rq_*.txt
ruff_fmt*.txt
docker_install.txt
pg_install.txt
fa_done.txt

# ── Repo-root scratch transcripts (added 2026-10) ────────────────────────────
# These are ad-hoc capture files from running analyze/test/ruff by hand. They
# are regenerated in seconds and were being committed at the repo root, so every
# clone and every `git log` carried ~140 stale copies of tool output.
#
# Pattern note: deliberately anchored to the repo root ("/rq_*.txt") rather than
# matching anywhere. A file named rq_*.txt inside a feature folder might be real
# work; one at the root is always scratch.
#
# They are UNTRACKED, not deleted — the files remain on disk.
/rq_*.txt
/analyze_*.txt
/analyze*.txt
/fa_done.txt
/rq2.txt
/test_screen*.png
/test_screen_fix*.png
/docker_install.txt
/pg_install.txt

# Analysis report dumps produced by the ad-hoc scripts above.
/analyze_out.txt
/analyze_full.txt
/analyze_output.txt
/analyze_after_regen.txt

# -- Credentials and access tokens -------------------------------------------
# NEVER tracked. Anything matching these was once a real credential on disk;
# they are ignored from here on. See docs/security/SECRET_ROTATION.md -- if one
# of these ever held a live key, ignoring it is NOT enough: the key must be
# rotated, because ignoring only stops the NEXT commit, not the last one.
_access.txt
_new_secret.txt
_refresh.txt
admin_token.txt
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example

# -- Tool output written next to the code ------------------------------------
# A test run or a build must never be able to dirty the tree. This is the rule
# that stops a scratch log being committed by accident and then appearing in
# every future diff as noise.
pytest_*.txt
pytest_*.log
scoped_pytest.log
backend_log.txt
*_out.txt
*_err.txt
alembic_bg.txt
analyze*.txt
ruff_fmt*.txt
