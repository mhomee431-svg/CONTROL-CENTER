# STAGING ENVIRONMENT - Pre-production validation. Real-ish but safe credentials.
ENVIRONMENT=staging
APP_NAME=Hyperlocal Customer API
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
FRONTEND_URL=https://staging.hyperlocal.app
BACKEND_URL=https://staging-api.hyperlocal.app

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://hyperlocal:CHANGE_ME@db.example.com:5432/hyperlocal_staging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
POSTGIS_EXTENSION=postgis

# Redis / Cache
REDIS_URL=redis://:CHANGE_ME@redis.example.com:6379/0
CACHE_DEFAULT_TTL=300

# Celery
CELERY_BROKER_URL=redis://:CHANGE_ME@redis.example.com:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis.example.com:6379/2
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# Security / JWT - Set a real secret in environment variables!
JWT_SECRET_KEY=CHANGE_ME_STAGING_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP
OTP_DEV_MODE=false
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# Providers (set real credentials as env vars, never commit)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=${CHANGE_ME}
TWILIO_AUTH_TOKEN=${CHANGE_ME}
TWILIO_FROM_NUMBER=+12025550123
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=noreply@hyperlocal.app
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=hyperlocal-staging-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# CORS
CORS_ORIGINS=https://staging.hyperlocal.app,https://admin-staging.hyperlocal.app

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH_ENDPOINT=5/minute
RATE_LIMIT_STORAGE_URI=redis://:CHANGE_ME@redis.example.com:6379/3

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000

# Logging (JSON in staging)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log