# ─────────────────────────────────────────────────────────────────────────────
# PHASE 4 — FREE CLOUD POSTGRESQL (Neon / Supabase) — EXAMPLE / DOCUMENTATION ONLY
#
# This is the canonical shape of Backend/.env.free, written automatically by
#   python scripts/provision_free_db.py <neon|supabase|import> ...
#
# • ENVIRONMENT=free lets the app's config loader (app/core/config.py) pick up
#   DATABASE_URL from this file when HYPERLOCAL_ENV/ENVIRONMENT are unset or
#   set to "free".
# • The ASYNC URL (asyncpg) is what FastAPI + Alembic use. asyncpg reads TLS
#   via the `ssl=require` query parameter (NOT sslmode — asyncpg rejects it).
# • The SYNC URL (psycopg) is what the verifier / one-shot jobs use. psycopg
#   uses libpq-style `sslmode=require`.
#
# ▶ Do NOT commit real credentials — copy this to .env.free locally and fill
#   in your real Neon/Supabase values, or (preferred) run provision_free_db.py
#   which writes the real .env.free for you.
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=free

# asyncpg (app + alembic) — replace host/role/password/database
DATABASE_URL=postgresql+asyncpg://REPLACE_ROLE:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB?ssl=require

# psycopg (verify scripts / sync jobs) — derived automatically by tooling
DATABASE_URL_SYNC=postgresql+psycopg://REPLACE_ROLE:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB?sslmode=require