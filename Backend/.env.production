# PRODUCTION ENVIRONMENT - Highest security. All secrets must come from OS env.
# Do NOT set real secrets in this file. Load via orchestration / secret manager.
ENVIRONMENT=production
APP_NAME=Hyperlocal Customer API
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
FRONTEND_URL=https://app.hyperlocal.in
BACKEND_URL=https://api.hyperlocal.in

# PostgreSQL - Supply via environment variable in orchestration, not here
# DATABASE_URL=postgresql+asyncpg://...

# Redis / Cache
# REDIS_URL=redis://...

# Celery
# CELERY_BROKER_URL=redis://...
# CELERY_RESULT_BACKEND=redis://...

# Security / JWT - MUST come from environment / secret manager in production
# JWT_SECRET_KEY=<from Vault / KMS>

# OTP
OTP_DEV_MODE=false
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# Providers - Set real credentials via environment variables only
SMS_PROVIDER=aws-sns
EMAIL_PROVIDER=aws-ses
STORAGE_PROVIDER=s3
S3_REGION=ap-south-1
S3_ACL=private

# CORS (locked to real domains)
CORS_ORIGINS=https://app.hyperlocal.in,https://admin.hyperlocal.in

# Rate Limiting (production-grade, backed by Redis)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH_ENDPOINT=5/minute
# RATE_LIMIT_STORAGE_URI=redis://.../3

# Security Headers (strict)
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Logging (JSON only, file-backed)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/app.log