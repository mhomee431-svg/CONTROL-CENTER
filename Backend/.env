# ── Core ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=Hyperlocal Customer API
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── PostgreSQL ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hyperlocal
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
POSTGIS_EXTENSION=postgis

# ── Redis / Cache ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=300

# ── Celery ─────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ── Security / JWT ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OTP ─────────────────────────────────────────────────────────────────────
OTP_DEV_MODE=true
OTP_DEV_VALUE=123456
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# ── Providers (mock for dev — set real secrets in staging/production) ──────
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
STORAGE_PROVIDER=local

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH_ENDPOINT=5/minute
RATE_LIMIT_STORAGE_URI=memory://

# ── Security Headers ────────────────────────────────────────────────────────
SECURITY_HEADERS_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_FILE_ENABLED=false