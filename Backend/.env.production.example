# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT — EXAMPLE / DOCUMENTATION ONLY
#
#   • Copy values you need. This file is a reference, NOT the source of truth.
#   • Real secrets are stored in Aws Secrets Manager and injected by ECS.
#   • Do NOT commit real values or this file with real data.
#
#  In AWS ECS these are set automatically for you:
#    ENVIRONMENT, DATABASE_URL, REDIS_URL, CELERY_*, STORAGE_PROVIDER, S3_*,
#    FRONTEND_URL, CORS_ORIGINS, USE_AWS_SECRETS, AWS_REGION.
#
#  Everything below that is a *secret* should live in the "backend" JSON
#  secret bundle in Secrets Manager (see infra/README.md).
# ═══════════════════════════════════════════════════════════════════════════

# ── Core (set by ECS) ───────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
DISABLE_DOCS=true

# Security enforced at startup (app/core/startup_checks.py)
JWT_SECRET_KEY=BELONGS_IN_SECRETS_MANAGER    # replace — 32+ chars random
OTP_DEV_MODE=false
# Fast2SMS OTP delivery — key comes from Secrets Manager; OTP_MODE=live sends real SMS
FAST2SMS_API_KEY=
OTP_MODE=live

# Google OAuth — credentials come from Secrets Manager
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_CALLBACK_URL
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true

# ── Distributed state (Redis on the app instance; DB allocation below) ──────
#   db0 = cache   db1 = celery broker   db2 = celery results
#   db3 = rate-limit counters   db4 = OTP records
RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/3
OTP_STORAGE_URI=redis://127.0.0.1:6379/4
# Behind the AWS ALB / Caddy reverse proxy — trust the proxy's X-Forwarded-For
TRUST_X_FORWARDED_FOR=true

# ── Secrets that MUST come from AWS Secrets Manager bundle ──────────────────
# Do not commit their values. Examples:
# SMS_PROVIDER        = twilio | aws-sns
# TWILIO_ACCOUNT_SID  / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER
# EMAIL_PROVIDER      = sendgrid | aws-ses
# SENDGRID_API_KEY
# PUSH_PROVIDER       = fcm
# FCM_CREDENTIALS_JSON
# JWT_SECRET_KEY, OTP_* adjustments, etc.

# ── AWS plumbing (set by ECS; usually not needed here) ──────────────────────
# USE_AWS_SECRETS=true
# AWS_SECRETS_SECRET_ID=hyperlocal/production
# AWS_REGION=us-east-1