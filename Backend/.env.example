# ─────────────────────────────────────────────────────────────────────────────
# HYPERLOCAL CUSTOMER API — Environment Configuration Reference
#
# Copy to `.env` (development) or `.env.<environment>` (test/staging/production)
# ENVIRONMENT is auto-selected from HYPERLOCAL_ENV / ENVIRONMENT system vars.
#
# ⚠️  NEVER commit real secrets. All provider keys must come from OS env vars
#     or a secret manager (Vault/KMS/SecretsManager) in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | test | staging | production
APP_NAME=Hyperlocal Customer API
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hyperlocal
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
POSTGIS_EXTENSION=postgis

# ── Redis / Cache ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=300

# ── Celery ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ── Security / JWT ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_ISSUER=hyperlocal-api
TOKEN_AUDIENCE=hyperlocal-app

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_DEV_MODE=true                       # Only true in development/test
OTP_DEV_VALUE=123456
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6
OTP_STORAGE_URI=memory://                # "redis://localhost:6379/4" for multi-worker/production

# Fast2SMS OTP delivery — OTP_MODE=mock prints the OTP to the server console
# (₹0 testing); OTP_MODE=live sends real SMS via https://www.fast2sms.com/dev/bulkV2
FAST2SMS_API_KEY=
OTP_MODE=mock                          # mock | live

# Google OAuth (social login) — register the callback as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Session / Tokens ───────────────────────────────────────────────────────────
SESSION_MAX_DEVICES=5
SESSION_IDLE_TIMEOUT_DAYS=30
REFRESH_TOKEN_ROTATION=true
REFRESH_TOKEN_REUSE_DETECTION=true

# ── SMS Provider (replaceable) ────────────────────────────────────────────────
SMS_PROVIDER=mock                       # mock | twilio | msg91 | aws-sns
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SECRET=
# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# AWS SNS
# AWS_SNS_ACCESS_KEY=
# AWS_SNS_SECRET_KEY=
# AWS_SNS_REGION=us-east-1

# ── Push Provider (replaceable; Phase 27) ───────────────────────────────────
PUSH_PROVIDER=mock                     # mock | fcm (Firebase Cloud Messaging)
# FCM credentials — supply via secret manager / env only. NEVER commit keys.
# FCM_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
# FCM_CREDENTIALS_JSON=               # raw service-account JSON string alternative
# FCM_DRY_RUN=false
# Anti-spam controls
NOTIFICATION_DEDUPE_COOLDOWN_SECONDS=3600
NOTIFICATION_HOURLY_CAP=20
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3

# ── Email Provider (replaceable) ──────────────────────────────────────────────
EMAIL_PROVIDER=mock                     # mock | smtp | sendgrid | aws-ses
EMAIL_FROM_ADDRESS=noreply@hyperlocal.app
EMAIL_FROM_NAME=Hyperlocal
# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SendGrid
# SENDGRID_API_KEY=
# AWS SES
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY=
# AWS_SES_SECRET_KEY=

# ── Object Storage (replaceable) ──────────────────────────────────────────────
STORAGE_PROVIDER=local                  # local | s3 | cloudinary
STORAGE_LOCAL_PATH=./storage/uploads
# S3
# S3_BUCKET_NAME=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=                     # leave empty on the cloud EC2: the
# S3_SECRET_ACCESS_KEY=                 # instance role supplies credentials
# S3_ENDPOINT_URL=                      # Optional for MinIO / wasabi
# Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Free-tier cloud EC2 (infra/terraform + docker-compose.cloud.yml) ─────────
# Written automatically by the instance boot script from SSM — do NOT commit:
# DATABASE_URL=postgresql+asyncpg://...@<rds-endpoint>/hyperlocal   (private RDS)
# DATABASE_URL_SYNC=postgresql://...      (same URL, sync driver, for celery)
# REDIS_URL=redis://redis:6379/0          (local container, compose network)
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/3
# JWT_SECRET_KEY=<random at boot>
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=<uploads bucket>
# S3_REGION=ap-south-1


# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ── Rate Limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH_ENDPOINT=5/minute
RATE_LIMIT_STORAGE_URI=memory://        # "redis://localhost:6379/3" in production
# Trust X-Forwarded-For for client IP keying — only when behind a reverse proxy (ALB/Caddy)
# TRUST_X_FORWARDED_FOR=false

# ── Security Headers ───────────────────────────────────────────────────────────
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                         # json | console
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/app.log

# ── Request / Correlation IDs ─────────────────────────────────────────────────
REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID