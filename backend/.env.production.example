# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# PRODUCTION ENVIRONMENT â€” EXAMPLE / DOCUMENTATION ONLY
#
#   â€¢ Copy values you need. This file is a reference, NOT the source of truth.
#   â€¢ Real secrets are stored in Aws Secrets Manager and injected by ECS.
#   â€¢ Do NOT commit real values or this file with real data.
#
#  In AWS ECS these are set automatically for you:
#    ENVIRONMENT, DATABASE_URL, REDIS_URL, CELERY_*, STORAGE_PROVIDER, S3_*,
#    FRONTEND_URL, CORS_ORIGINS, USE_AWS_SECRETS, AWS_REGION.
#
#  Everything below that is a *secret* should live in the "backend" JSON
#  secret bundle in Secrets Manager (see infrastructure/README.md).
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€ Core (set by ECS) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ENVIRONMENT=production
DEBUG=false
DISABLE_DOCS=true

# Security enforced at startup (app/core/startup_checks.py)
JWT_SECRET_KEY=BELONGS_IN_SECRETS_MANAGER    # replace â€” 32+ chars random

# Google OAuth â€” credentials come from Secrets Manager
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_CALLBACK_URL
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true

# â”€â”€ Distributed state (Redis on the app instance; DB allocation below) â”€â”€â”€â”€â”€â”€
#   db0 = cache   db1 = celery broker   db2 = celery results
#   db3 = rate-limit counters   db4 = OTP records
RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/3
OTP_STORAGE_URI=redis://127.0.0.1:6379/4
# Behind the AWS ALB / Caddy reverse proxy â€” trust the proxy's X-Forwarded-For
TRUST_X_FORWARDED_FOR=true

# â”€â”€ Secrets that MUST come from AWS Secrets Manager bundle â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Do not commit their values. Examples:
# SMS_PROVIDER        = twilio | aws-sns
# TWILIO_ACCOUNT_SID  / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER
# EMAIL_PROVIDER      = sendgrid | aws-ses
# SENDGRID_API_KEY
# PUSH_PROVIDER       = fcm
# FCM_CREDENTIALS_JSON
# JWT_SECRET_KEY, OTP_* adjustments, etc.

# â”€â”€ Payments (Phase 28) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# The built-in MockPaymentProvider signs checkouts/webhooks with this secret.
# Production REFUSES to boot while it is the default or missing â€” set a strong
# 32+ char random value (or register a real gateway). Normally from Secrets Manager.
# MOCK_PAYMENT_SECRET=

# â”€â”€ AWS plumbing (set by ECS; usually not needed here) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# USE_AWS_SECRETS=true
# AWS_SECRETS_SECRET_ID=hyperlocal/production
# AWS_REGION=us-east-1

# â”€â”€ Observability (Phase 24) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Structured log enrichment: service name + static node label so multi-container
# logs are filterable (api / worker / beat share the same LOG_SERVICE_NAME).
LOG_SERVICE_NAME=hyperlocal-customer-api
# LOG_EXTRA_FIELDS=node=api-1
# Protect GET /metrics with a bearer token when it is reachable from anywhere
# other than the VPC/prometheus CIDR. Secrets Manager is the right home.
# METRICS_TOKEN=BELONGS_IN_SECRETS_MANAGER
# Post alert events to an Alertmanager/Slack webhook (in addition to logs).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
