# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# HYPERLOCAL CUSTOMER API â€” Environment Configuration Reference
#
# Copy to `.env` (development) or `.env.<environment>` (test/staging/production)
# ENVIRONMENT is auto-selected from HYPERLOCAL_ENV / ENVIRONMENT system vars.
#
# âš ï¸  NEVER commit real secrets. All provider keys must come from OS env vars
#     or a secret manager (Vault/KMS/SecretsManager) in production.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€ Core â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ENVIRONMENT=development                 # development | test | staging | production
APP_NAME=Hyperlocal Customer API
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# â”€â”€ PostgreSQL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hyperlocal
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
POSTGIS_EXTENSION=postgis

# â”€â”€ Redis / Cache â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=300

# â”€â”€ Celery â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# â”€â”€ Security / JWT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_ISSUER=hyperlocal-api
TOKEN_AUDIENCE=hyperlocal-app
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_COOLDOWN_SECONDS=60

# SMS OTP is sent by Firebase client-side; the backend verifies the resulting
# Firebase ID token. No third-party SMS gateway / API key needed.
# The OTP_* settings below are retained only for the legacy customer OTP flow
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6
OTP_STORAGE_URI=memory://                # "redis://localhost:6379/4" for multi-worker/production

# â”€â”€ Firebase Phone Authentication â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Reuse the FCM service account (same JSON works for Auth + FCM) or point to
# a dedicated one. Leave FIREBASE_* empty to fall back to FCM_CREDENTIALS_FILE.
FIREBASE_CREDENTIALS_FILE=
# FIREBASE_CREDENTIALS_JSON=              # raw JSON string alternative

# Google OAuth (social login) â€” register the callback as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# â”€â”€ Session / Tokens â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SESSION_MAX_DEVICES=5
SESSION_IDLE_TIMEOUT_DAYS=30
REFRESH_TOKEN_ROTATION=true
REFRESH_TOKEN_REUSE_DETECTION=true

# â”€â”€ SMS Provider (replaceable) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SMS_PROVIDER=mock                       # mock | twilio | msg91 | aws-sns
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SECRET=
# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# AWS SNS
# AWS_SNS_ACCESS_KEY=
# AWS_SNS_SECRET_KEY=
# AWS_SNS_REGION=us-east-1

# â”€â”€ Payments (Phase 28) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Signature secret for the built-in MockPaymentProvider. Replace with a strong
# random value (32+ chars) anywhere near production â€” the startup security gate
# refuses to boot in production while this is the published default.
# MOCK_PAYMENT_SECRET=mock-payment-secret

# â”€â”€ Push Provider (replaceable; Phase 27) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PUSH_PROVIDER=mock                     # mock | fcm (Firebase Cloud Messaging)
# FCM credentials â€” supply via secret manager / env only. NEVER commit keys.
# FCM_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
# FCM_CREDENTIALS_JSON=               # raw service-account JSON string alternative
# FCM_DRY_RUN=false
# Anti-spam controls
NOTIFICATION_DEDUPE_COOLDOWN_SECONDS=3600
NOTIFICATION_HOURLY_CAP=20
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3

# â”€â”€ Merchant Onboarding & Verification Providers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Environment for verification providers: sandbox | production
# IMPORTANT: sandbox must NEVER be used in production
VERIFICATION_ENV=sandbox

# Identity Verification (GSTIN/UDYAM)
IDENTITY_PROVIDER=sandbox                  # sandbox | production
# GST_PROVIDER_API_KEY=                     # Required for production GST provider
# UDYAM_PROVIDER_API_KEY=                   # Required for production UDYAM provider

# Bank Account Verification (Penny Drop)
BANK_PROVIDER=sandbox                      # sandbox | cashfree | razorpay
# BANK_PROVIDER_API_KEY=                    # Required for production bank provider
# BANK_PROVIDER_SECRET=                     # Required for production bank provider

# Category Document Verification
CATEGORY_PROVIDER=sandbox                  # sandbox | production
# FSSAI_PROVIDER_API_KEY=                   # Required for production FSSAI provider
# TRANSPORT_PROVIDER_API_KEY=               # Required for production transport provider

# â”€â”€ Email Provider (replaceable) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
EMAIL_PROVIDER=mock                     # mock | smtp | sendgrid | aws-ses
EMAIL_FROM_ADDRESS=noreply@hyperlocal.app
EMAIL_FROM_NAME=Hyperlocal
# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SendGrid
# SENDGRID_API_KEY=
# AWS SES
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY=
# AWS_SES_SECRET_KEY=

# â”€â”€ Object Storage (replaceable) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STORAGE_PROVIDER=local                  # local | s3 | cloudinary
STORAGE_LOCAL_PATH=./storage/uploads
# S3
# S3_BUCKET_NAME=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=                     # leave empty on the cloud EC2: the
# S3_SECRET_ACCESS_KEY=                 # instance role supplies credentials
# S3_ENDPOINT_URL=                      # Optional for MinIO / wasabi
# Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# â”€â”€ Free-tier cloud EC2 (infrastructure/terraform + docker-compose.cloud.yml) â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Written automatically by the instance boot script from SSM â€” do NOT commit:
# DATABASE_URL=postgresql+asyncpg://...@<rds-endpoint>/hyperlocal   (private RDS)
# DATABASE_URL_SYNC=postgresql://...      (same URL, sync driver, for celery)
# REDIS_URL=redis://redis:6379/0          (local container, compose network)
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/3
# JWT_SECRET_KEY=<random at boot>
# MOCK_PAYMENT_SECRET=<random at boot>    (mock gateway signing secret; strong in prod)
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=<uploads bucket>
# S3_REGION=ap-south-1

# Phase 7 â€” media upload limits & signed URL lifetimes
# MEDIA_MAX_IMAGE_BYTES=5242880          # 5 MB (product/shop images)
# MEDIA_MAX_DOCUMENT_BYTES=15728640      # 15 MB (documents)
# S3_UPLOAD_URL_EXPIRES_SECONDS=600      # signed POST policy lifetime
# S3_DOWNLOAD_URL_EXPIRES_SECONDS=900    # presigned GET lifetime


# â”€â”€ CORS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# â”€â”€ Rate Limiting â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH_ENDPOINT=5/minute
RATE_LIMIT_STORAGE_URI=memory://        # "redis://localhost:6379/3" in production
# Trust X-Forwarded-For for client IP keying â€” only when behind a reverse proxy (ALB/Caddy)
# TRUST_X_FORWARDED_FOR=false

# â”€â”€ Security Headers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# â”€â”€ Logging â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                         # json | console
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/app.log

# â”€â”€ Observability (Phase 24) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Service name + optional static labels attached to every structured log line
LOG_SERVICE_NAME=hyperlocal-customer-api
# LOG_EXTRA_FIELDS=node=api-1,shard=0
# When set, GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>".
# Leave empty when the metrics endpoint is only reachable on a private network
# or already protected by the reverse proxy.
# METRICS_TOKEN=
# When set, alert events are POSTed to this webhook (Prometheus Alertmanager,
# Slack, etc.) in addition to the structured log.
# ALERT_WEBHOOK_URL=

# â”€â”€ Request / Correlation IDs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
